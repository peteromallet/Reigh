{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    /* Bundler mode */
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Type safety */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@tbd/editor": ["./packages/editor/src/index.ts"],
      "@tbd/schema": ["./packages/schema/src/index.ts"],
      "@tbd/engine": ["./packages/engine/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**"
  ]
}
