{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reigh.dev/schemas/reigh-extension.schema.json",
  "title": "Reigh Extension Manifest",
  "description": "Schema for Reigh video-editor extension manifests. Validated at package-load time; invalid manifests are rejected with structured diagnostics.",
  "type": "object",
  "required": ["id", "name", "version", "apiVersion"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique extension identifier (e.g. com.example.my-extension).",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable extension name.",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "description": "Extension version (semver).",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "apiVersion": {
      "type": "string",
      "description": "Required runtime API version (semver). Must be same-major compatible with runtime API 1.0.0.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "description": {
      "type": "string",
      "description": "Optional prose description."
    },
    "author": {
      "type": "string",
      "description": "Optional author attribution."
    },
    "permissions": {
      "type": "array",
      "description": "Declarative permission allow-list. Only known permissions are accepted.",
      "items": {
        "type": "string",
        "enum": [
          "timeline:read",
          "timeline:write",
          "assets:read",
          "assets:write"
        ]
      },
      "uniqueItems": true
    },
    "settingsSchema": {
      "description": "JSON Schema describing extension settings. Default values are used as baseline settings.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "boolean"
        }
      ]
    },
    "contributions": {
      "type": "object",
      "description": "Declared contribution descriptors.",
      "additionalProperties": false,
      "properties": {
        "slots": {
          "type": "array",
          "description": "Slot contribution descriptors.",
          "items": {
            "type": "object",
            "required": ["slot", "id"],
            "additionalProperties": false,
            "properties": {
              "slot": {
                "type": "string",
                "enum": [
                  "header",
                  "toolbar",
                  "leftPanel",
                  "rightPanel",
                  "timelineFooter",
                  "statusBar",
                  "dialogs",
                  "assetPanel",
                  "inspectorPanel"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "number"
              }
            }
          },
          "uniqueItems": true
        },
        "dialogs": {
          "type": "array",
          "description": "Dialog contribution descriptors.",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "number"
              },
              "layer": {
                "type": "string",
                "enum": ["modal", "overlay"]
              }
            }
          },
          "uniqueItems": true
        },
        "panels": {
          "type": "array",
          "description": "Panel contribution descriptors.",
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "number"
              }
            }
          },
          "uniqueItems": true
        },
        "inspectorSections": {
          "type": "array",
          "description": "Inspector section contribution descriptors.",
          "items": {
            "type": "object",
            "required": ["id", "placement"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "placement": {
                "type": "string",
                "enum": ["before-default", "after-default"]
              },
              "order": {
                "type": "number"
              }
            }
          },
          "uniqueItems": true
        },
        "commands": {
          "type": "array",
          "description": "Command contribution descriptors. Each declares a command that the extension contributes to the command palette, context menus, and keybinding registry. Local IDs are namespaced as `${manifest.id}.${localCommandId}` at load time.",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Local command identifier (e.g. 'myCommand'). The runtime prepends the manifest id to form the fully-qualified command ID.",
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
              },
              "title": {
                "type": "string",
                "description": "Human-readable command label shown in the command palette.",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "description": "Optional prose description for the command palette."
              },
              "proposal": {
                "type": "boolean",
                "description": "When true, executing this command opens the proposal review UI before committing timeline changes. Defaults to false.",
                "default": false
              },
              "keybinding": {
                "type": "object",
                "description": "Optional default keybinding. Users can override this in settings.",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Primary key (e.g. 'Ctrl+Shift+P').",
                    "minLength": 1
                  },
                  "mac": {
                    "type": "string",
                    "description": "macOS-specific override (e.g. 'Cmd+Shift+P').",
                    "minLength": 1
                  }
                }
              },
              "menu": {
                "type": "object",
                "description": "Optional context menu placement.",
                "additionalProperties": false,
                "properties": {
                  "context": {
                    "type": "string",
                    "description": "Menu context where this command appears.",
                    "enum": [
                      "timeline-context",
                      "clip-context",
                      "track-context",
                      "clip-selection-context",
                      "canvas-context"
                    ]
                  },
                  "group": {
                    "type": "string",
                    "description": "Group name for ordering within the menu.",
                    "minLength": 1
                  },
                  "order": {
                    "type": "number",
                    "description": "Sort order within the group."
                  }
                }
              }
            }
          },
          "uniqueItems": true
        }
      }
    }
  }
}
